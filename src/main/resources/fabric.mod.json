{
  "schemaVersion": 1,
  "id": "tamacraft",
  "version": "${version}",
  "name": "Tamacraft",
  "description": "Find, tame and care for ten cute pixel pets. Inspired by the classic Tamagotchi virtual pets of the 90s; not affiliated with or endorsed by Bandai.",
  "authors": [
    "Kasax"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/tamacraft",
    "sources": "https://github.com/Kasax007/tamacraft",
    "issues": "https://github.com/Kasax007/tamacraft/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.kasax.tamacraft.Tamacraft"
    ],
    "client": [
      "net.kasax.tamacraft.client.TamacraftClient"
    ],
    "jei_mod_plugin": [
      "net.kasax.tamacraft.compat.JeiCompat"
    ],
    "rei_client": [
      "net.kasax.tamacraft.compat.ReiCompat"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.161.0"
  },
  "mixins": [
    "tamacraft.mixins.json"
  ],
  "icon": "assets/tamacraft/icon.png"
}